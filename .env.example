# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL (local development only)
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=restaurant_copilot
# Read-only login used to run LLM-generated SQL
POSTGRES_READONLY_PASSWORD=copilot_readonly

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
